# JWT secret for signing tokens — use a strong random value in production
JWT_SECRET='change-me-to-a-random-string'

# Admin default password
ADMIN_PASSWORD='change-me-to-a-strong-password'

# Server port
PORT=3000

# JWT token expiry
JWT_EXPIRY=7d

# ntfy push notifications (self-hosted)
NTFY_ENABLED=false
NTFY_URL=https://your-ntfy-server.com/topic-name
NTFY_USER=your-ntfy-username
NTFY_PASSWORD=change-me-to-a-strong-password
